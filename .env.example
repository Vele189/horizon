# =============================================================================
# Climate Volatility & Risk Engine — environment template
# =============================================================================
# Copy this file to `.env` and fill in the values:
#
#     cp .env.example .env
#
# `.env` is git-ignored. This file is the ONLY place variable names are
# documented, and `config.py` is the ONLY place they are read. Never leave a
# real value in this file — it is committed to a public repository.
# =============================================================================


# -----------------------------------------------------------------------------
# Environment selector
# -----------------------------------------------------------------------------
# Which target the pipeline operates against: "local" or "serving".
# Controls defaults and safety checks only; the connection itself comes from
# DATABASE_URL below. See §5.4 of docs/proposal.md.
ENVIRONMENT=local


# -----------------------------------------------------------------------------
# Warehouse connections
# -----------------------------------------------------------------------------
# The active target. Every component — ingestion, dbt, ML, dashboard — reads
# this one variable. Switching between Docker Postgres and Neon is a change of
# value here and nothing else. Never hardcode a connection string.
#
#   Local (Docker Compose):
#     postgresql://climate:CHANGEME@localhost:5432/climate
#   Neon (serving) — always the POOLED endpoint, note "-pooler" in the host:
#     postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Neon serving connection, used by the gold-mart promotion (Day 11) and by the
# deployed dashboard. Take the POOLED endpoint from the Neon console or from
# `neon connection-string production --project-id <id> --pooled`; the host must
# contain "-pooler" and the string must keep sslmode=require. Leave blank during
# local development.
SERVING_DATABASE_URL=


# -----------------------------------------------------------------------------
# Local Postgres (docker-compose.yml)
# -----------------------------------------------------------------------------
# Docker Compose reads these to provision the local container. They must agree
# with the credentials embedded in the local form of DATABASE_URL above.
POSTGRES_USER=climate
POSTGRES_PASSWORD=
POSTGRES_DB=climate

# Host port the container publishes on. Change this if 5432 is already taken by
# another Postgres on your machine; DATABASE_URL above must use the same port.
POSTGRES_PORT=5432


# -----------------------------------------------------------------------------
# Source API — Open-Meteo Historical Archive (ERA5)
# -----------------------------------------------------------------------------
# NOTE: Open-Meteo's archive endpoint requires NO API key. There is deliberately
# no credential variable here. If the NOAA GHCN-Daily fallback (§5.1) is ever
# adopted, its token belongs in this block and nowhere else.
OPENMETEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive

# Timeouts are set as an explicit (connect, read) pair — requests applies no
# timeout at all by default, and a socket that opens but never answers would
# otherwise hang a multi-hour backfill forever.
#
# Seconds to wait for the TCP connection to be established. Short: a host that
# is not accepting connections fails fast and is retried.
REQUEST_CONNECT_TIMEOUT_SECONDS=10

# Seconds to wait between bytes once connected. This is the read timeout, not a
# total budget for the request. A single city-year of hourly data is a few
# hundred kilobytes, so 30s is generous.
REQUEST_TIMEOUT_SECONDS=30

# Total tenacity attempts per request, not retries on top of the first try:
# 5 means one initial call and four retries before the chunk is abandoned.
MAX_RETRY_ATTEMPTS=5

# Base seconds for the exponential backoff between retries. Waits are jittered
# so fifteen cities backing off together do not resynchronise into a thundering
# herd. HTTP 429 ignores this and honours the Retry-After header instead.
RETRY_BACKOFF_SECONDS=2


# -----------------------------------------------------------------------------
# Paths
# -----------------------------------------------------------------------------
# Gzipped raw API responses land here. Git-ignored and NOT stored in Postgres —
# per-row raw JSON would exhaust Neon's 0.5 GB budget (§5.4).
DATA_RAW_DIR=data/raw

# Versioned .joblib models and metrics.json.
MODEL_ARTIFACT_DIR=machine_learning/artifacts

# City definitions: name, country, lat, lon, elevation (§6 Workstream 1).
CITIES_CONFIG_PATH=config/cities.yml

# Structured pipeline logs.
LOG_DIR=logs


# -----------------------------------------------------------------------------
# dbt
# -----------------------------------------------------------------------------
# Directory holding profiles.yml. dbt reads DATABASE_URL through an env_var()
# lookup in the profile, so no credentials live in the dbt project itself.
DBT_PROFILES_DIR=dbt_analytics

# Profile target to build against: "dev" (local Docker) or "prod" (Neon).
DBT_TARGET=dev


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
