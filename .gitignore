# ---------------------------------------------------------------------------
# Secrets: nothing in this block may ever be committed.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.yml
secrets.yaml

# Neon CLI local context, written by `neon link` / `neon init`.
.neon
.neon/

# ---------------------------------------------------------------------------
# Data: raw API payloads are gzipped to disk, never to git (see §5.4).
# ---------------------------------------------------------------------------
data/
!data/.gitkeep
data/raw/
*.csv
*.parquet
*.gz
!docs/**/*.csv

# ---------------------------------------------------------------------------
# Model artifacts
# ---------------------------------------------------------------------------
*.joblib
*.pkl
machine_learning/artifacts/*
!machine_learning/artifacts/.gitkeep

# metrics.json is the exception, and deliberately so. The baseline scores it
# holds are the target a model is measured against, and a target is only fixed
# in advance if it is committed in advance.
!machine_learning/artifacts/metrics.json

# So is the model itself, while it stays small. Streamlit Community Cloud
# cannot reach the warehouse the model is trained from, so an artefact outside
# the repository means the deployed dashboard has no model at all. git cannot
# express "unless it is under two megabytes", so the rule lives in
# tests/test_artifact.py, which fails on any tracked .joblib over the
# threshold. Everything else matching *.joblib above stays ignored.
!machine_learning/artifacts/model-*.joblib

# ---------------------------------------------------------------------------
# dbt
# ---------------------------------------------------------------------------
.dbt/
dbt_analytics/profiles.yml
dbt_analytics/target/
dbt_analytics/dbt_packages/
dbt_analytics/logs/
.user.yml

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
logs/
*.log

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
env/
ENV/
.python-version

# ---------------------------------------------------------------------------
# Tooling / test caches
# ---------------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Streamlit
# ---------------------------------------------------------------------------
.streamlit/secrets.toml

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
