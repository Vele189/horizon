# Streamlit secrets — copy to .streamlit/secrets.toml and fill in.
#
#     cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# secrets.toml is git-ignored. This example is committed and must never hold a
# real value. Deployed, this file has no equivalent on disk: paste the same
# key into Streamlit Community Cloud under Manage app → Settings → Secrets,
# where it is stored encrypted and injected at runtime.
#
# A local .env with SERVING_DATABASE_URL already works and is the usual way to
# run against Neon from a development machine — dashboard/database.py falls
# back to it. This file exists for the deployed shape of the same thing, and to
# let that shape be exercised locally before deploying.

# The serving warehouse. On Streamlit Community Cloud there is exactly one
# database and it is Neon, so it takes the plain name.
#
# Use the **pooled** endpoint — the host with `-pooler` in it. Streamlit runs
# one process serving every visitor, and Neon's pooler is what keeps a burst of
# sessions from exhausting the connection limit on a free-plan compute.
#
# Keep `sslmode=require`. Neon refuses an unencrypted connection, so dropping it
# does not silently downgrade — but it does turn a clear configuration error
# into a connection failure at first query.
DATABASE_URL = "postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
